<!--
Descripcion:
  Opciones del rack de Performance Pads.
  Incluye guardar/cargar el banco de samples, que es lo que persiste las
  asignaciones de los pads en modo SAMPLER.
-->
<Template>
  <WidgetGroup>
  <ObjectName></ObjectName>
  <SizePolicy>me,f</SizePolicy>
  <Layout>stacked</Layout>
  <Children>
    <!-- translucent cover when Library is maximized -->
    <Template src="skins:LateNight/helpers/skin_settings_cover.xml">
      <SetVariable name="Setting">[Skin],show_maximized_library</SetVariable>
    </Template>

    <WidgetGroup>
      <SizePolicy>me,min</SizePolicy>
      <Layout>vertical</Layout>
      <Children>
        <WidgetGroup>
          <Layout>horizontal</Layout>
          <Size>180min,1min</Size>
          <Children>
            <Template src="skins:LateNight/helpers/skin_settings_labelbutton_2state.xml">
              <SetVariable name="TooltipId">show_pads</SetVariable>
              <SetVariable name="Text">Pads </SetVariable>
              <SetVariable name="Setting">[Skin],show_pads</SetVariable>
              <SetVariable name="Width">115f</SetVariable>
            </Template>
            <WidgetGroup><Size>0me,1min</Size></WidgetGroup>
          </Children>
        </WidgetGroup>

        <WidgetGroup>
          <ObjectName>SkinSettingsCategory</ObjectName>
          <SizePolicy>me,f</SizePolicy>
          <Layout>stacked</Layout>
          <Children>
            <!-- capa translucida cuando los pads estan ocultos -->
            <Template src="skins:LateNight/helpers/skin_settings_cover_inverted.xml">
              <SetVariable name="Setting">[Skin],show_pads</SetVariable>
            </Template>

            <WidgetGroup>
              <Layout>vertical</Layout>
              <SizePolicy>me,min</SizePolicy>
              <Children>
                <WidgetGroup>
                  <ObjectName>SamplerLoadSaveBox</ObjectName>
                  <Layout>horizontal</Layout>
                  <Size>180min,1min</Size>
                  <Children>
                    <PushButton>
                      <TooltipId>LoadSamplerBank</TooltipId>
                      <ObjectName>SkinSettingsButton</ObjectName>
                      <Size>35f,18f</Size>
                      <NumberStates>1</NumberStates>
                      <State>
                        <Number>0</Number>
                        <Text> Load </Text>
                        <Alignment>left</Alignment>
                      </State>
                      <Connection>
                        <ConfigKey>[Sampler],LoadSamplerBank</ConfigKey>
                        <ButtonState>LeftButton</ButtonState>
                      </Connection>
                    </PushButton>
                    <Label>
                      <TooltipId>SaveSamplerBank</TooltipId>
                      <ObjectName>SkinSettingsText</ObjectName>
                      <Size>6min,18f</Size>
                      <Text>/</Text>
                      <Alignment>center</Alignment>
                    </Label>
                    <PushButton>
                      <TooltipId>SaveSamplerBank</TooltipId>
                      <ObjectName>SkinSettingsButton</ObjectName>
                      <Size>35f,18f</Size>
                      <NumberStates>1</NumberStates>
                      <State>
                        <Number>0</Number>
                        <Text> Save </Text>
                        <Alignment>left</Alignment>
                      </State>
                      <Connection>
                        <ConfigKey>[Sampler],SaveSamplerBank</ConfigKey>
                        <ButtonState>LeftButton</ButtonState>
                      </Connection>
                    </PushButton>
                    <Label>
                      <TooltipId>SaveSamplerBank</TooltipId>
                      <ObjectName>SkinSettingsText</ObjectName>
                      <Size>140min,18f</Size>
                      <Text>Pad Samples</Text>
                      <Alignment>left</Alignment>
                    </Label>
                  </Children>
                </WidgetGroup>
              </Children>
            </WidgetGroup>

          </Children>
        </WidgetGroup>
      </Children>
    </WidgetGroup>
  </Children>
</WidgetGroup>
</Template>
