<!--
Descripcion:
  Pagina de pads en modo SAMPLER: cuadricula 2x4 (pads 1-4 arriba, 5-8 abajo).

  Cada deck tiene su propio banco de 8 samples. LateNight pide 16 samplers:
  el deck 1 usa Sampler 1-8 y el deck 2 usa Sampler 9-16, definidos en
  pad_grid_deckN.xml (SamplerPad1..8).

Variables:
  SamplerPad1 .. SamplerPad8 : indices globales [SamplerN] de este deck
-->
<Template>
  <WidgetGroup>
    <ObjectName>PadPage</ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>me,min</SizePolicy>
    <Children>

      <WidgetGroup>
        <ObjectName>PadRow</ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>me,min</SizePolicy>
        <Children>
          <Template src="skins:LateNight/pads/pad_cell_sampler.xml">
            <SetVariable name="PadNum">1</SetVariable>
            <SetVariable name="SamplerNum"><Variable name="SamplerPad1"/></SetVariable>
          </Template>
          <Template src="skins:LateNight/pads/pad_cell_sampler.xml">
            <SetVariable name="PadNum">2</SetVariable>
            <SetVariable name="SamplerNum"><Variable name="SamplerPad2"/></SetVariable>
          </Template>
          <Template src="skins:LateNight/pads/pad_cell_sampler.xml">
            <SetVariable name="PadNum">3</SetVariable>
            <SetVariable name="SamplerNum"><Variable name="SamplerPad3"/></SetVariable>
          </Template>
          <Template src="skins:LateNight/pads/pad_cell_sampler.xml">
            <SetVariable name="PadNum">4</SetVariable>
            <SetVariable name="SamplerNum"><Variable name="SamplerPad4"/></SetVariable>
          </Template>
        </Children>
      </WidgetGroup><!-- PadRow 1-4 -->

      <WidgetGroup>
        <ObjectName>PadRow</ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>me,min</SizePolicy>
        <Children>
          <Template src="skins:LateNight/pads/pad_cell_sampler.xml">
            <SetVariable name="PadNum">5</SetVariable>
            <SetVariable name="SamplerNum"><Variable name="SamplerPad5"/></SetVariable>
          </Template>
          <Template src="skins:LateNight/pads/pad_cell_sampler.xml">
            <SetVariable name="PadNum">6</SetVariable>
            <SetVariable name="SamplerNum"><Variable name="SamplerPad6"/></SetVariable>
          </Template>
          <Template src="skins:LateNight/pads/pad_cell_sampler.xml">
            <SetVariable name="PadNum">7</SetVariable>
            <SetVariable name="SamplerNum"><Variable name="SamplerPad7"/></SetVariable>
          </Template>
          <Template src="skins:LateNight/pads/pad_cell_sampler.xml">
            <SetVariable name="PadNum">8</SetVariable>
            <SetVariable name="SamplerNum"><Variable name="SamplerPad8"/></SetVariable>
          </Template>
        </Children>
      </WidgetGroup><!-- PadRow 5-8 -->

    </Children>
  </WidgetGroup><!-- PadPage -->
</Template>
