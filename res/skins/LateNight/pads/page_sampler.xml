<!--
Descripcion:
  Pagina de pads en modo SAMPLER: cuadricula 2x4 (pads 1-4 arriba, 5-8 abajo),
  igual que la disposicion fisica de una DDJ.

  En Rekordbox el banco de samples es global: los pads de cualquier deck
  disparan los mismos samples. Por eso ambos decks apuntan a [Sampler1]..[Sampler8]
  en lugar de tener un banco por deck.
-->
<Template>
  <WidgetGroup>
    <ObjectName>PadPage</ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>me,min</SizePolicy>
    <Children>

      <WidgetGroup>
        <ObjectName>PadRow</ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>me,min</SizePolicy>
        <Children>
          <Template src="skins:LateNight/pads/pad_cell_sampler.xml">
            <SetVariable name="PadNum">1</SetVariable>
            <SetVariable name="SamplerNum">1</SetVariable>
          </Template>
          <Template src="skins:LateNight/pads/pad_cell_sampler.xml">
            <SetVariable name="PadNum">2</SetVariable>
            <SetVariable name="SamplerNum">2</SetVariable>
          </Template>
          <Template src="skins:LateNight/pads/pad_cell_sampler.xml">
            <SetVariable name="PadNum">3</SetVariable>
            <SetVariable name="SamplerNum">3</SetVariable>
          </Template>
          <Template src="skins:LateNight/pads/pad_cell_sampler.xml">
            <SetVariable name="PadNum">4</SetVariable>
            <SetVariable name="SamplerNum">4</SetVariable>
          </Template>
        </Children>
      </WidgetGroup><!-- PadRow 1-4 -->

      <WidgetGroup>
        <ObjectName>PadRow</ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>me,min</SizePolicy>
        <Children>
          <Template src="skins:LateNight/pads/pad_cell_sampler.xml">
            <SetVariable name="PadNum">5</SetVariable>
            <SetVariable name="SamplerNum">5</SetVariable>
          </Template>
          <Template src="skins:LateNight/pads/pad_cell_sampler.xml">
            <SetVariable name="PadNum">6</SetVariable>
            <SetVariable name="SamplerNum">6</SetVariable>
          </Template>
          <Template src="skins:LateNight/pads/pad_cell_sampler.xml">
            <SetVariable name="PadNum">7</SetVariable>
            <SetVariable name="SamplerNum">7</SetVariable>
          </Template>
          <Template src="skins:LateNight/pads/pad_cell_sampler.xml">
            <SetVariable name="PadNum">8</SetVariable>
            <SetVariable name="SamplerNum">8</SetVariable>
          </Template>
        </Children>
      </WidgetGroup><!-- PadRow 5-8 -->

    </Children>
  </WidgetGroup><!-- PadPage -->
</Template>
