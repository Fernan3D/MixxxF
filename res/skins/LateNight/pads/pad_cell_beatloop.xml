<!--
Descripcion:
  Pad en modo BEAT LOOP. Cada pad activa o desactiva un loop de un tamano
  fijo (1/8 ... 16 beats) con beatloop_<size>_toggle. El LED del pad sigue
  beatloop_<size>_enabled para ver cual esta puesto.

Variables:
  PadNum    : numero visible del pad (1-8)
  LoopSize  : tamano Mixxx (0.125, 0.25, 0.5, 1, 2, 4, 8, 16)
  LoopLabel : texto del pad (1/8, 1/4...)
  Group     : grupo del deck, [ChannelN]
-->
<Template>
  <WidgetGroup>
    <ObjectName>PadCell</ObjectName>
    <Layout>vertical</Layout>
    <Size>0me,54f</Size>
    <MinimumSize>80,54</MinimumSize>
    <Children>

      <WidgetGroup>
        <ObjectName>PadCellHeader</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,16f</Size>
        <Children>
          <Label>
            <ObjectName>PadNumber</ObjectName>
            <Size>13f,16f</Size>
            <Text><Variable name="PadNum"/></Text>
            <Alignment>center</Alignment>
          </Label>
          <Label>
            <ObjectName>PadCaption</ObjectName>
            <Size>0me,16f</Size>
            <Text>LOOP</Text>
            <Alignment>left</Alignment>
          </Label>
        </Children>
      </WidgetGroup><!-- PadCellHeader -->

      <PushButton>
        <TooltipId>beatloop_activate</TooltipId>
        <ObjectName>PadLoop</ObjectName>
        <Size>0me,38f</Size>
        <NumberStates>2</NumberStates>
        <State>
          <Number>0</Number>
          <Text><Variable name="LoopLabel"/></Text>
          <Alignment>center</Alignment>
        </State>
        <State>
          <Number>1</Number>
          <Text><Variable name="LoopLabel"/></Text>
          <Alignment>center</Alignment>
        </State>
        <Connection>
          <ConfigKey><Variable name="Group"/>,beatloop_<Variable name="LoopSize"/>_toggle</ConfigKey>
          <ButtonState>LeftButton</ButtonState>
        </Connection>
        <Connection>
          <ConfigKey><Variable name="Group"/>,beatloop_<Variable name="LoopSize"/>_enabled</ConfigKey>
          <ConnectValueFromWidget>false</ConnectValueFromWidget>
        </Connection>
      </PushButton>

    </Children>
  </WidgetGroup><!-- PadCell -->
</Template>
