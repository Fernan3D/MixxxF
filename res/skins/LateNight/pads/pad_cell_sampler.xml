<!--
Descripcion:
  Pad individual en modo SAMPLER.

  Se construye sobre TrackWidgetGroup para aceptar pistas arrastradas desde
  la biblioteca y pintar el color de la pista.

  Los controles de play, eject y orientacion al crossfader son los mismos
  que usaba la barra inferior de Sampler (ya retirada): icono de play,
  eject clasico y el interruptor L/M/R de tres estados.

Variables:
  PadNum     : numero visible del pad (1-8)
  SamplerNum : sampler Mixxx de este pad ([SamplerN]). El deck 1 usa 1-8 y
               el deck 2 usa 9-16, para que no compartan banco.
-->
<Template>
  <SetVariable name="Group">[Sampler<Variable name="SamplerNum"/>]</SetVariable>

  <!-- Ancho elastico: la cuadricula llena la columna del deck hasta el mixer. -->
  <TrackWidgetGroup>
    <ObjectName>PadCell</ObjectName>
    <Group><Variable name="Group"/></Group>
    <!-- Alpha bajo para que el color de la pista tinte el pad sin tapar el texto -->
    <TrackColorAlpha>150</TrackColorAlpha>
    <Layout>vertical</Layout>
    <Size>0me,58f</Size>
    <MinimumSize>80,58</MinimumSize>
    <Children>

      <!-- Cabecera: numero de pad y nombre del sample -->
      <WidgetGroup>
        <ObjectName>PadCellHeader</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,16f</Size>
        <Children>

          <Label>
            <ObjectName>PadNumber</ObjectName>
            <Size>13f,16f</Size>
            <Text><Variable name="PadNum"/></Text>
            <Alignment>center</Alignment>
          </Label>

          <TrackProperty>
            <TooltipId>track_title</TooltipId>
            <ObjectName>PadTitle</ObjectName>
            <Size>0me,16f</Size>
            <Group><Variable name="Group"/></Group>
            <Property>titleInfo</Property>
            <Elide>right</Elide>
          </TrackProperty>

        </Children>
      </WidgetGroup><!-- PadCellHeader -->

      <!-- Play a la izquierda; BPM, eject y L/M/R a la derecha, como el rack. -->
      <WidgetGroup>
        <ObjectName>PadSamplerRow</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,42f</Size>
        <Children>

          <WidgetGroup>
            <ObjectName>PadSamplerPlayBox</ObjectName>
            <Layout>stacked</Layout>
            <SizePolicy>max,max</SizePolicy>
            <Children>
              <Template src="skins:LateNight/controls/button_2state_right_display.xml">
                <SetVariable name="TooltipId">cue_gotoandplay_cue_default</SetVariable>
                <SetVariable name="ObjectName">PlaySampler</SetVariable>
                <SetVariable name="Size">34f,34f</SetVariable>
                <SetVariable name="BtnType"><Variable name="TopRegion_BtnType"/></SetVariable>
                <SetVariable name="BtnSize">square_big</SetVariable>
                <SetVariable name="ConfigKey"><Variable name="Group"/>,cue_gotoandplay</SetVariable>
                <SetVariable name="ConfigKeyRight"><Variable name="Group"/>,cue_default</SetVariable>
                <SetVariable name="ConfigKeyDisp"><Variable name="Group"/>,play_latched</SetVariable>
              </Template>
              <PushButton>
                <ObjectName>PreviewIndicator</ObjectName>
                <Size>34f,34f</Size>
                <NumberStates>2</NumberStates>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,play</ConfigKey>
                </Connection>
              </PushButton>
            </Children>
          </WidgetGroup><!-- PadSamplerPlayBox -->

          <Number>
            <TooltipId>visual_bpm</TooltipId>
            <ObjectName>SamplerBpmMini</ObjectName>
            <Size>0me,18f</Size>
            <Group><Variable name="Group"/></Group>
            <Alignment>left</Alignment>
            <Connection>
              <ConfigKey><Variable name="Group"/>,visual_bpm</ConfigKey>
            </Connection>
            <Connection>
              <ConfigKey><Variable name="Group"/>,track_loaded</ConfigKey>
              <BindProperty>visible</BindProperty>
            </Connection>
          </Number>

          <WidgetGroup><Size>0me,0min</Size></WidgetGroup>

          <!-- Eject y orientacion solo con sample cargado, igual que el rack. -->
          <WidgetGroup>
            <ObjectName>PadSamplerTools</ObjectName>
            <Layout>horizontal</Layout>
            <Size>42f,18f</Size>
            <Children>
              <Template src="skins:LateNight/controls/button_1state.xml">
                <SetVariable name="TooltipId">eject</SetVariable>
                <SetVariable name="ObjectName">EjectButton12</SetVariable>
                <SetVariable name="BtnType"></SetVariable>
                <SetVariable name="ConfigKey"><Variable name="Group"/>,eject</SetVariable>
                <SetVariable name="Size">21f,18f</SetVariable>
              </Template>
              <PushButton>
                <TooltipId>orientation</TooltipId>
                <ObjectName>PadSamplerXfader</ObjectName>
                <Size>21f,18f</Size>
                <NumberStates>3</NumberStates>
                <State>
                  <Number>0</Number>
                  <Pressed scalemode="STRETCH_ASPECT">skins:LateNight/<Variable name="BtnScheme"/>/buttons/btn__xfader_sampler_left.svg</Pressed>
                  <Unpressed scalemode="STRETCH_ASPECT">skins:LateNight/<Variable name="BtnScheme"/>/buttons/btn__xfader_sampler_left.svg</Unpressed>
                </State>
                <State>
                  <Number>1</Number>
                  <Pressed scalemode="STRETCH_ASPECT">skins:LateNight/<Variable name="BtnScheme"/>/buttons/btn__xfader_sampler_main.svg</Pressed>
                  <Unpressed scalemode="STRETCH_ASPECT">skins:LateNight/<Variable name="BtnScheme"/>/buttons/btn__xfader_sampler_main.svg</Unpressed>
                </State>
                <State>
                  <Number>2</Number>
                  <Pressed scalemode="STRETCH_ASPECT">skins:LateNight/<Variable name="BtnScheme"/>/buttons/btn__xfader_sampler_right.svg</Pressed>
                  <Unpressed scalemode="STRETCH_ASPECT">skins:LateNight/<Variable name="BtnScheme"/>/buttons/btn__xfader_sampler_right.svg</Unpressed>
                </State>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,orientation</ConfigKey>
                  <ButtonState>LeftButton</ButtonState>
                </Connection>
              </PushButton>
            </Children>
            <Connection>
              <ConfigKey><Variable name="Group"/>,track_loaded</ConfigKey>
              <BindProperty>visible</BindProperty>
            </Connection>
          </WidgetGroup><!-- PadSamplerTools -->

        </Children>
      </WidgetGroup><!-- PadSamplerRow -->

    </Children>
  </TrackWidgetGroup><!-- PadCell -->
</Template>
