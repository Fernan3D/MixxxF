<!--
Descripcion:
  Bloque de Performance Pads del deck 1: barra de modos + cuadricula de 8 pads.
  Vive dentro de la columna del deck (decks_left.xml) para ocupar el mismo
  ancho que el deck, hasta el mixer.

  El indice de pagina vive en [PadBank1],mode:
    0 HOT CUE, 1 BEAT LOOP, 2 LOOP ROLL, 3 PAD FX, 4 BEAT JUMP, 5 SAMPLER
  y se conserva entre sesiones. Las paginas no usan "trigger": el modo lo
  escriben los botones de la barra.

  Existe un archivo por deck porque el formato de skin no sustituye variables
  dentro de los atributos XML (currentpage).
-->
<Template>
  <SetVariable name="PadDeck">1</SetVariable>
  <SetVariable name="PadBank">[PadBank1]</SetVariable>
  <SetVariable name="Group">[Channel1]</SetVariable>
  <!-- Banco de samples propio del deck 1: Sampler 1-8 -->
  <SetVariable name="SamplerPad1">1</SetVariable>
  <SetVariable name="SamplerPad2">2</SetVariable>
  <SetVariable name="SamplerPad3">3</SetVariable>
  <SetVariable name="SamplerPad4">4</SetVariable>
  <SetVariable name="SamplerPad5">5</SetVariable>
  <SetVariable name="SamplerPad6">6</SetVariable>
  <SetVariable name="SamplerPad7">7</SetVariable>
  <SetVariable name="SamplerPad8">8</SetVariable>

  <WidgetGroup>
    <ObjectName>PadBank</ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>me,min</SizePolicy>
    <MinimumSize>400,150</MinimumSize>
    <Children>

      <Template src="skins:LateNight/pads/pad_mode_bar.xml"/>

      <WidgetStack currentpage="[PadBank1],mode" persist="true">
        <Size>0me,124f</Size>
        <Children>

          <WidgetGroup>
            <Layout>vertical</Layout>
            <SizePolicy>me,min</SizePolicy>
            <Children>
              <Template src="skins:LateNight/pads/page_hotcue.xml"/>
            </Children>
          </WidgetGroup>

          <WidgetGroup>
            <Layout>vertical</Layout>
            <SizePolicy>me,min</SizePolicy>
            <Children>
              <Template src="skins:LateNight/pads/page_beatloop.xml"/>
            </Children>
          </WidgetGroup>

          <WidgetGroup>
            <Layout>vertical</Layout>
            <SizePolicy>me,min</SizePolicy>
            <Children>
              <Template src="skins:LateNight/pads/page_looproll.xml"/>
            </Children>
          </WidgetGroup>

          <WidgetGroup>
            <Layout>vertical</Layout>
            <SizePolicy>me,min</SizePolicy>
            <Children>
              <Template src="skins:LateNight/pads/page_padfx.xml"/>
            </Children>
          </WidgetGroup>

          <WidgetGroup>
            <Layout>vertical</Layout>
            <SizePolicy>me,min</SizePolicy>
            <Children>
              <Template src="skins:LateNight/pads/page_beatjump.xml"/>
            </Children>
          </WidgetGroup>

          <WidgetGroup>
            <Layout>vertical</Layout>
            <SizePolicy>me,min</SizePolicy>
            <Children>
              <Template src="skins:LateNight/pads/page_sampler.xml"/>
            </Children>
          </WidgetGroup>

        </Children>
      </WidgetStack>

    </Children>
    <Connection>
      <ConfigKey persist="true">[Skin],show_pads</ConfigKey>
      <BindProperty>visible</BindProperty>
    </Connection>
  </WidgetGroup><!-- PadBank -->
</Template>
