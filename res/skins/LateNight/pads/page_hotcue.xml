<!--
Descripcion:
  Pagina de pads en modo HOT CUE: hotcues 1-8 del deck en cuadricula 2x4.

Variables:
  Group : grupo del deck, [ChannelN]
-->
<Template>
  <WidgetGroup>
    <ObjectName>PadPage</ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>min,min</SizePolicy>
    <Children>

      <WidgetGroup>
        <ObjectName>PadRow</ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>min,min</SizePolicy>
        <Children>
          <Template src="skins:LateNight/pads/pad_cell_hotcue.xml">
            <SetVariable name="PadNum">1</SetVariable>
            <SetVariable name="HotcueNum">1</SetVariable>
          </Template>
          <Template src="skins:LateNight/pads/pad_cell_hotcue.xml">
            <SetVariable name="PadNum">2</SetVariable>
            <SetVariable name="HotcueNum">2</SetVariable>
          </Template>
          <Template src="skins:LateNight/pads/pad_cell_hotcue.xml">
            <SetVariable name="PadNum">3</SetVariable>
            <SetVariable name="HotcueNum">3</SetVariable>
          </Template>
          <Template src="skins:LateNight/pads/pad_cell_hotcue.xml">
            <SetVariable name="PadNum">4</SetVariable>
            <SetVariable name="HotcueNum">4</SetVariable>
          </Template>
        </Children>
      </WidgetGroup><!-- PadRow 1-4 -->

      <WidgetGroup>
        <ObjectName>PadRow</ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>min,min</SizePolicy>
        <Children>
          <Template src="skins:LateNight/pads/pad_cell_hotcue.xml">
            <SetVariable name="PadNum">5</SetVariable>
            <SetVariable name="HotcueNum">5</SetVariable>
          </Template>
          <Template src="skins:LateNight/pads/pad_cell_hotcue.xml">
            <SetVariable name="PadNum">6</SetVariable>
            <SetVariable name="HotcueNum">6</SetVariable>
          </Template>
          <Template src="skins:LateNight/pads/pad_cell_hotcue.xml">
            <SetVariable name="PadNum">7</SetVariable>
            <SetVariable name="HotcueNum">7</SetVariable>
          </Template>
          <Template src="skins:LateNight/pads/pad_cell_hotcue.xml">
            <SetVariable name="PadNum">8</SetVariable>
            <SetVariable name="HotcueNum">8</SetVariable>
          </Template>
        </Children>
      </WidgetGroup><!-- PadRow 5-8 -->

    </Children>
  </WidgetGroup><!-- PadPage -->
</Template>
