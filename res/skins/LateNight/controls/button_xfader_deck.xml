<!DOCTYPE template>
<!--
  Orientacion L/M/R del canal respecto al crossfader.

  Un PushButton de 3 estados (clic: Izquierda -> Centro -> Derecha).
  Tamano fijo y SizeConstraint para que el padre elastico del mixer
  no recorte el widget al hacer hover.
-->
<Template>
  <WidgetGroup>
    <ObjectName>CrossfaderButtonContainer_<Variable name="DeckGroup"/></ObjectName>
    <Layout>horizontal</Layout>
    <Size>33f,16f</Size>
    <MinimumSize>33,16</MinimumSize>
    <MaximumSize>33,16</MaximumSize>
    <SizePolicy>f,f</SizePolicy>
    <SizeConstraint>SetMinAndMaxSize</SizeConstraint>
    <Children>
      <PushButton>
        <ObjectName>XfaderDeckOrient</ObjectName>
        <TooltipId>orientation</TooltipId>
        <Size>33f,16f</Size>
        <MinimumSize>33,16</MinimumSize>
        <MaximumSize>33,16</MaximumSize>
        <NumberStates>3</NumberStates>
        <State>
          <Number>0</Number>
          <Pressed scalemode="STRETCH">skins:LateNight/<Variable name="BtnScheme"/>/buttons/btn__xfader_deck_left_<Variable name="xfaderLeft"/>.svg</Pressed>
          <Unpressed scalemode="STRETCH">skins:LateNight/<Variable name="BtnScheme"/>/buttons/btn__xfader_deck_left_<Variable name="xfaderLeft"/>.svg</Unpressed>
        </State>
        <State>
          <Number>1</Number>
          <Pressed scalemode="STRETCH">skins:LateNight/<Variable name="BtnScheme"/>/buttons/btn__xfader_deck_mid_<Variable name="xfaderMid"/>.svg</Pressed>
          <Unpressed scalemode="STRETCH">skins:LateNight/<Variable name="BtnScheme"/>/buttons/btn__xfader_deck_mid_<Variable name="xfaderMid"/>.svg</Unpressed>
        </State>
        <State>
          <Number>2</Number>
          <Pressed scalemode="STRETCH">skins:LateNight/<Variable name="BtnScheme"/>/buttons/btn__xfader_deck_right_<Variable name="xfaderRight"/>.svg</Pressed>
          <Unpressed scalemode="STRETCH">skins:LateNight/<Variable name="BtnScheme"/>/buttons/btn__xfader_deck_right_<Variable name="xfaderRight"/>.svg</Unpressed>
        </State>
        <Connection>
          <ConfigKey><Variable name="Group"/>,orientation</ConfigKey>
          <ButtonState>LeftButton</ButtonState>
        </Connection>
      </PushButton>
    </Children>
  </WidgetGroup>
</Template>
