<!DOCTYPE template>
<!--
  Orientacion L/M/R del canal al crossfader.

  Mismo ancho que el selector Quick Effect, un poco mas alto.
  El icono se centra (STRETCH_ASPECT). Un clic recorre L -> M -> R.
-->
<Template>
  <PushButton>
    <TooltipId>orientation</TooltipId>
    <ObjectName>OrientationButton<Variable name="Unit"/></ObjectName>
    <Size>0me,26f</Size>
    <MinimumSize>40,26</MinimumSize>
    <SizePolicy>me,f</SizePolicy>
    <NumberStates>3</NumberStates>
    <State>
      <Number>0</Number>
      <Pressed scalemode="STRETCH_ASPECT">skins:LateNight/buttons/ic_orientation_left.svg</Pressed>
      <Unpressed scalemode="STRETCH_ASPECT">skins:LateNight/buttons/ic_orientation_left.svg</Unpressed>
    </State>
    <State>
      <Number>1</Number>
      <Pressed scalemode="STRETCH_ASPECT">skins:LateNight/buttons/ic_orientation_center.svg</Pressed>
      <Unpressed scalemode="STRETCH_ASPECT">skins:LateNight/buttons/ic_orientation_center.svg</Unpressed>
    </State>
    <State>
      <Number>2</Number>
      <Pressed scalemode="STRETCH_ASPECT">skins:LateNight/buttons/ic_orientation_right.svg</Pressed>
      <Unpressed scalemode="STRETCH_ASPECT">skins:LateNight/buttons/ic_orientation_right.svg</Unpressed>
    </State>
    <Connection>
      <ConfigKey><Variable name="Group"/>,orientation</ConfigKey>
      <ButtonState>LeftButton</ButtonState>
    </Connection>
  </PushButton>
</Template>
