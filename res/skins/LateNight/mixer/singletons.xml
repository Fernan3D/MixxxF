<!DOCTYPE template>
<Template>
  <SetVariable name="ChannelType">channel</SetVariable>
  <SetVariable name="VuSize">deck</SetVariable>
  <SetVariable name="VuColor">dark</SetVariable>

  <SingletonDefinition>
    <ObjectName>CrossfaderSingleton</ObjectName>
    <Children>
      <WidgetGroup>
        <Size>115f,58f</Size>
        <Children>
          <!-- WidgetGroup around slider to draw a style border
          around it when AutoDJ is enabled. Note that it doesn't
          work without the extra outer WidgetGroup -->
          <WidgetGroup>
            <Size>115f,58f</Size>
            <ObjectName>CrossfaderContainer</ObjectName>
            <Connection>
              <ConfigKey>[AutoDJ],enabled</ConfigKey>
              <BindProperty>highlight</BindProperty>
            </Connection>
            <Children>
              <SliderComposed>
                <TooltipId>crossfader</TooltipId>
                <Size>115f,58f</Size>
                <Handle scalemode="STRETCH_ASPECT">skins:LateNight/<Variable name="SliderScheme"/>/sliders/knob_crossfader.svg</Handle>
                <!-- MixxxF: Qt no pinta el SVG de Inkscape; se usa PNG generado. -->
                <Slider scalemode="STRETCH">skins:LateNight/<Variable name="SliderScheme"/>/sliders/slider_crossfader.png</Slider>
                <Horizontal>true</Horizontal>
                <HandlePadding>0.150</HandlePadding>
                <BarWidth>0</BarWidth>
                <Connection>
                  <ConfigKey>[Master],crossfader</ConfigKey>
                </Connection>
              </SliderComposed>
            </Children>
          </WidgetGroup>
        </Children>
      </WidgetGroup>
    </Children>
  </SingletonDefinition>

  <SingletonDefinition>
    <ObjectName>VuMeterChannel1</ObjectName>
    <Children>
      <WidgetGroup>
        <Layout>horizontal</Layout>
        <SizePolicy>min,me</SizePolicy>
        <Children>
          <Template src="skins:LateNight/mixer/vumeter_single.xml">
            <SetVariable name="Group">[Channel1]</SetVariable>
          </Template>
        </Children>
      </WidgetGroup>
    </Children>
  </SingletonDefinition>

  <SingletonDefinition>
    <ObjectName>VuMeterChannel2</ObjectName>
    <Children>
      <WidgetGroup>
        <Layout>horizontal</Layout>
        <SizePolicy>min,me</SizePolicy>
        <Children>
          <Template src="skins:LateNight/mixer/vumeter_single.xml">
            <SetVariable name="Group">[Channel2]</SetVariable>
          </Template>
        </Children>
      </WidgetGroup>
    </Children>
  </SingletonDefinition>

  <SingletonDefinition>
    <ObjectName>VuMeterChannel3</ObjectName>
    <Children>
      <WidgetGroup>
        <Layout>horizontal</Layout>
        <SizePolicy>min,me</SizePolicy>
        <Children>
          <Template src="skins:LateNight/mixer/vumeter_single.xml">
            <SetVariable name="Group">[Channel3]</SetVariable>
          </Template>
        </Children>
      </WidgetGroup>
    </Children>
  </SingletonDefinition>

  <SingletonDefinition>
    <ObjectName>VuMeterChannel4</ObjectName>
    <Children>
      <WidgetGroup>
        <Layout>horizontal</Layout>
        <SizePolicy>min,me</SizePolicy>
        <Children>
          <Template src="skins:LateNight/mixer/vumeter_single.xml">
            <SetVariable name="Group">[Channel4]</SetVariable>
          </Template>
        </Children>
      </WidgetGroup>
    </Children>
  </SingletonDefinition>

  <SingletonDefinition>
    <ObjectName>VuMeterMain_Dark</ObjectName>
    <Children>
      <WidgetGroup>
        <Layout>horizontal</Layout>
        <SizePolicy>min,me</SizePolicy>
        <Children>
          <Template src="skins:LateNight/mixer/vumeter_main.xml">
            <SetVariable name="VuColor">dark</SetVariable>
          </Template>
        </Children>
      </WidgetGroup>
    </Children>
  </SingletonDefinition>

  <SingletonDefinition>
    <ObjectName>VuMeterMain_Light</ObjectName>
    <Children>
      <WidgetGroup>
        <Layout>horizontal</Layout>
        <SizePolicy>min,me</SizePolicy>
        <Children>
          <Template src="skins:LateNight/mixer/vumeter_main.xml">
            <SetVariable name="VuColor">light</SetVariable>
          </Template>
        </Children>
      </WidgetGroup>
    </Children>
  </SingletonDefinition>
</Template>
